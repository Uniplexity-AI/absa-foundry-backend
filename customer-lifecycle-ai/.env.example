# ============================================================
# Customer Lifecycle Prediction System - Environment Variables
# ============================================================
# TODO: Replace with actual values and use a secrets manager in production

# ---- Environment ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_lifecycle
POSTGRES_USER=clp_user
POSTGRES_PASSWORD=clp_password
DATABASE_URL=postgresql://clp_user:clp_password@localhost:5432/customer_lifecycle

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- API Gateway ----
GATEWAY_PORT=8080
GATEWAY_SECRET_KEY=change-me-in-production

# ---- JWT / Auth ----
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Service Ports (3-Layer AI Architecture) ----
DATA_INGESTION_SERVICE_PORT=8001
FEATURE_ENGINEERING_SERVICE_PORT=8002
CUSTOMER_STATE_SERVICE_PORT=8003
PREDICTION_SERVICE_PORT=8004
DECISION_INTELLIGENCE_SERVICE_PORT=8005
MODEL_MANAGEMENT_SERVICE_PORT=8006
DASHBOARD_SERVICE_PORT=8007
ORCHESTRATION_SERVICE_PORT=8008

# ---- Model Selection ----
PREDICTION_MODEL_TYPE=xgboost
PREDICTION_MODEL_BACKUP=lightgbm

# ---- Health Score Weights ----
HEALTH_SCORE_CHURN_WEIGHT=0.40
HEALTH_SCORE_CLV_WEIGHT=0.30
HEALTH_SCORE_BEHAVIOUR_WEIGHT=0.30

# ---- Champion/Challenger ----
CHAMPION_CHALLENGER_ENABLED=true
CHALLENGER_TRAFFIC_SPLIT=0.10

# ---- ML Model Paths ----
MODEL_REGISTRY_PATH=./models
CHAMPION_MODEL_PATH=./models/champion
CHALLENGER_MODEL_PATH=./models/challenger
MODEL_ARCHIVE_PATH=./models/archive

# ---- Datasets ----
RAW_DATA_PATH=./datasets/raw
PROCESSED_DATA_PATH=./datasets/processed

# ---- Monitoring (Future) ----
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ---- Security ----
ENCRYPTION_ENABLED=false
AUDIT_LOGGING_ENABLED=true

# ---- LLM narration (Ollama) — ADR-005: narration only, never a decision ----
# Requires `ollama serve` and the model pulled: `ollama pull qwen2.5-coder:7b`
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=180
LLM_GATEWAY_TIMEOUT_SECONDS=180
